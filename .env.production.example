# ==============================================================================
# MULTICATÁLOGO - ARCHIVO DE VARIABLES DE ENTORNO (PRODUCCIÓN ULTRA-SEGURA)
# ==============================================================================
# INSTRUCCIONES:
#   1. Copie este archivo a .env:
#      cp .env.production.example .env
#   2. Genere claves seguras con:
#      openssl rand -base64 32
#   3. Asegúrese de NO versionar el archivo .env final.
# ==============================================================================

# Entorno general
APP_ENV=production

# Puertos Host expuestos (Gateway Nginx recibe el tráfico exterior)
GATEWAY_PORT=80
GATEWAY_SSL_PORT=443

# Puertos internos expuestos solo para monitoreo o administración (opcional)
DB_HOST_PORT=5434
REDIS_HOST_PORT=6379

# Credenciales de Base de Datos PostgreSQL 16
DB_HOST=postgres
DB_PORT=5432
DB_USER=mc_admin
DB_PASSWORD=CAMBIAR_POR_PASSWORD_ROBUSTO_DE_BASE_DE_DATOS_123!
DB_NAME=multicatalogo_prod

# Credenciales y configuración de Caché Redis 7
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CAMBIAR_POR_TOKEN_REDIS_SEGURO_456!

# Clave criptográfica para firmas de tokens JWT (HS256)
# IMPORTANTE: Reemplace con una cadena aleatoria de mínimo 32 caracteres
JWT_SECRET=CAMBIAR_POR_HASH_CRIPTO_DE_ALTA_ENTROPIA_PROD_2026_XYZ!

# Token de Cloudflare Tunnel (Opcional para servidores caseros sin IP pública fija)
# Si se define, el despliegue activa automáticamente el perfil tunnel
# CLOUDFLARE_TUNNEL_TOKEN=eyJh...
