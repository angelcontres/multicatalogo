# ==========================================
# MultiCatálogo - Root .gitignore
# ==========================================

# Dependencies
node_modules/
vendor/

# Build and distribution outputs
dist/
dist-ssr/
build/
out/
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Environment and sensitive files
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
!*.env.example

# Database & persistence data directories
pgdata/
redisdata/
*.sqlite
*.sqlite3
*.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
Desktop.ini

# Python / Jupyter checkpoints
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/

# Vite / Frontend cache
.vite/
.eslintcache
