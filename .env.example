# ==============================================================================
# MULTICATÁLOGO - ARCHIVO DE VARIABLES DE ENTORNO (DESARROLLO / LOCAL)
# ==============================================================================

# Entorno general (development | production)
APP_ENV=development

# Puertos Host expuestos
GATEWAY_PORT=80
GATEWAY_SSL_PORT=443
BACKEND_PORT=3000
DB_HOST_PORT=5434
REDIS_HOST_PORT=6379

# Configuración de Base de Datos PostgreSQL 16
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=multicatalogo

# Configuración de Redis 7 Alpine
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Seguridad y Autenticación JWT HS256
JWT_SECRET=multicatalogo-jwt-secret-dev-2026-very-secure
