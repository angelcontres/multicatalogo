{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/?source=pwa",
  "name": "MultiCatálogo — E-commerce & Red Multinivel",
  "short_name": "MultiCatálogo",
  "description": "Catálogo digital cosmético interactivo, tienda a pantalla completa y gestión de red de distribución multinivel.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "portrait",
  "background_color": "#0f172a",
  "theme_color": "#4f46e5",
  "lang": "es",
  "dir": "ltr",
  "categories": [
    "shopping",
    "business",
    "lifestyle"
  ],
  "icons": [
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "Catálogo de Productos",
      "short_name": "Catálogo",
      "description": "Explorar productos cosméticos y ofertas",
      "url": "/catalogo",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Mi Red Multinivel",
      "short_name": "Mi Red",
      "description": "Consultar equipo de referidos y comisiones",
      "url": "/mi-red",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Carrito de Compras",
      "short_name": "Carrito",
      "description": "Ver artículos seleccionados para comprar",
      "url": "/carrito",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Tienda Inmersiva",
      "short_name": "Tienda",
      "description": "Storefront a pantalla completa",
      "url": "/tienda",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
